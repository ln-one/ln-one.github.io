---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import SpectraGraphDemo from '~/components/graph-view/SpectraGraphDemo';

const metadata = {
  title: 'Chunran Zhang | Research and Software Systems',
  description:
    'Chunran Zhang works on RAG, exact adaptive hybrid retrieval, AI agents, and retrieval systems built inside Qdrant.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>

  <section id="about" class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
    <div class="grid items-center gap-10 md:grid-cols-[240px_minmax(0,1fr)] md:gap-14">
      <img
        src="/images/chunran-cafe-portrait.jpg"
        alt="Chunran Zhang"
        width="878"
        height="900"
        class="mx-auto aspect-[4/5] w-full max-w-[230px] rounded-3xl object-cover object-center shadow-lg ring-1 ring-black/5 dark:ring-white/10"
      />

      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-secondary">
          Southwest Jiaotong University · Software Engineering
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">Hello, I’m Chunran Zhang.</h1>
        <p class="mt-5 text-lg leading-8 text-muted md:text-xl">
          I work primarily on AI agent systems. Spectra is the project to which I have devoted the most time. Building
          it introduced me to RAG and to a problem with the fixed Top-L cutoff used in hybrid retrieval.
        </p>
        <p class="mt-4 text-lg leading-8 text-muted">
          Instead of treating Top-L as another parameter to tune, I turned the issue into a research question and
          developed EAHR. Implementing the method then took me into Qdrant itself, where I built StratuMind as a fork of
          the database.
        </p>
        <p class="mt-4 text-sm font-semibold text-default">
          EAHR is available as
          <a
            href="https://arxiv.org/abs/2608.07152"
            target="_blank"
            rel="noopener noreferrer"
            class="text-secondary underline decoration-blue-300 underline-offset-4 hover:text-blue-600 dark:decoration-blue-700"
            >arXiv:2608.07152 [cs.IR]</a
          >.
        </p>
        <p class="mt-6 text-sm font-semibold text-default">
          Software Engineering undergraduate · Expected graduation: 2027 · Applying for graduate study
        </p>
      </div>
    </div>
  </section>

  <section id="spectra" class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-24">
    <div class="grid items-center gap-10 lg:grid-cols-[0.82fr_1.18fr] lg:gap-14">
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-secondary">Spectra · Intelligent Education System</p>
        <h2 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">Spectra began with a competition</h2>
        <p class="mt-5 text-lg leading-8 text-muted">
          I first developed Spectra for the China Undergraduate Service Outsourcing Innovation and Entrepreneurship
          Competition. We set out to build a usable education product that brought document processing, knowledge bases,
          RAG, and agent workflows together, rather than stopping at a competition demo.
        </p>
        <p class="mt-4 text-lg leading-8 text-muted">
          I led a team of five. Apart from a small part of the visual UI design, I was responsible for the product
          design, system architecture, and core implementation. Spectra reached the national final and remains the
          system into which I have put the most work.
        </p>

        <div class="mt-8 space-y-5 border-l border-gray-200 pl-6 dark:border-slate-700">
          <div>
            <h3 class="font-semibold">Knowledge spaces can reference one another</h3>
            <p class="mt-1 text-sm leading-6 text-muted">
              One knowledge space can reference another without copying its contents. An Intelligent Construction
              course, for example, can draw on spaces for artificial intelligence, civil engineering, BIM, IoT, and
              project management.
            </p>
          </div>
          <div>
            <h3 class="font-semibold">Designed for work across disciplines</h3>
            <p class="mt-1 text-sm leading-6 text-muted">
              Referenced material keeps its original structure and provenance while knowledge from different fields can
              be recombined in a new course. The same mechanism supports interdisciplinary teaching, research
              collaboration, and the use of industry cases in the classroom.
            </p>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-xs font-semibold uppercase tracking-wide text-muted">
          <span>National finalist</span>
          <span>Team lead, five members</span>
          <span>Core system built by me, except for part of the visual frontend design</span>
          <a
            href="https://www.fwwb.org.cn/attached/file/20260629/20260629173558_286.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-full border border-gray-300 px-3 py-1.5 normal-case transition hover:border-blue-400 hover:text-blue-600 dark:border-slate-600"
          >
            <Icon name="tabler:external-link" class="h-4 w-4" />
            Official finalist list: Group A, No. 4, Crab Canon
          </a>
        </div>
      </div>

      <div class="min-w-0">
        <SpectraGraphDemo client:visible />
      </div>
    </div>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a
        href="https://spectra.forevergreendam.cn"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700"
      >
        Try Spectra
      </a>
      <a
        href="https://github.com/ln-one/Spectra"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border-2 border-black bg-white px-6 py-2.5 text-sm font-semibold text-black shadow-sm transition hover:bg-gray-100"
      >
        <Icon name="tabler:brand-github" class="h-5 w-5 text-black" />
        GitHub
      </a>
    </div>
    <p class="mt-3 flex items-center justify-center gap-1.5 text-sm font-semibold text-blue-600 dark:text-blue-400">
      <Icon name="tabler:clock" class="h-4 w-4" />
      The live system is available daily from 9:00 to 21:00 China Standard Time
    </p>
  </section>

  <section
    class="relative mx-auto max-w-5xl px-4 py-10 sm:px-6 md:py-16"
    aria-label="From product work to a research question"
  >
    <div
      class="rounded-3xl border border-blue-200 bg-blue-50/70 px-6 py-10 text-center dark:border-blue-900 dark:bg-blue-950/20 md:px-12"
    >
      <p class="text-sm font-bold uppercase tracking-widest text-secondary">From Spectra to EAHR</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">
        In a RAG system, fixed Top-L is more than a tuning choice
      </h2>
      <p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-muted">
        Spectra is an agent system built around RAG, so developing it led me to hybrid retrieval. A common pipeline
        takes a fixed Top-L from the dense and sparse rankers before fusing their candidates. At first, L appears to be
        a simple way to control retrieval cost.
      </p>
      <p class="mx-auto mt-4 max-w-3xl text-lg leading-8 text-muted">
        But the same cutoff determines both which ranks enter fusion and how deeply each channel executes. Candidate
        depth therefore becomes a quality-cost hyperparameter that does not transfer reliably across queries or corpus
        snapshots. I chose to study that coupling instead of continuing to retune L, which led to EAHR.
      </p>
    </div>
  </section>

  <section id="eahr" class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-bold uppercase tracking-widest text-secondary">The research question</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">
        Can hybrid retrieval work without a fixed Top-L?
      </h2>
      <p class="mt-5 text-lg text-muted md:text-xl">
        EAHR defines the target as the ordered Top-K produced by weighted RRF over the complete dense and sparse
        rankings. Rather than choosing a channel depth in advance, it reads each ranking incrementally for the current
        request and stops only when the unread suffixes can no longer change Top-K membership or order.
      </p>
      <p class="mt-4 text-sm font-semibold text-default">Single-author preprint · arXiv:2608.07152 · cs.IR · 2026</p>
    </div>

    <div
      class="mt-12 overflow-hidden rounded-2xl border border-gray-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900 md:p-6"
    >
      <img
        src="/research/eahr-overview.svg"
        alt="Fixed Top-L fusion compared with exact adaptive execution in EAHR"
        class="h-auto w-full"
        loading="lazy"
      />
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <article class="rounded-xl border border-gray-200 p-6 dark:border-slate-700">
        <h3 class="text-xl font-semibold">Define the result first</h3>
        <p class="mt-2 text-muted">
          The target is always the ordered Top-K from weighted RRF over the complete dense and sparse rankings, with a
          deterministic identity rule for ties.
        </p>
      </article>
      <article class="rounded-xl border border-gray-200 p-6 dark:border-slate-700">
        <h3 class="text-xl font-semibold">Exact rank streams that can resume</h3>
        <p class="mt-2 text-muted">
          PVS and PBM publish stable, exact prefixes of the dense and sparse rankings. Execution can pause and resume,
          and a published rank is never revised later.
        </p>
      </article>
      <article class="rounded-xl border border-gray-200 p-6 dark:border-slate-700">
        <h3 class="text-xl font-semibold">A certified stopping rule</h3>
        <p class="mt-2 text-muted">
          Fusion continues only while an unread rank could still affect Top-K membership or order. Difficult requests
          safely continue to exhaustion.
        </p>
      </article>
    </div>

    <div class="mt-8 text-center">
      <a
        href="https://arxiv.org/abs/2608.07152"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex rounded-full border border-gray-300 px-5 py-2.5 text-sm font-semibold transition hover:border-blue-400 hover:text-blue-600 dark:border-slate-600"
      >
        Read on arXiv
      </a>
    </div>
  </section>

  <section
    id="stratumind"
    class="relative border-y border-gray-200 bg-gray-50 dark:border-slate-800 dark:bg-slate-900/40"
  >
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-24">
      <div class="grid items-start gap-12 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <p class="text-sm font-bold uppercase tracking-widest text-secondary">StratuMind · Systems implementation</p>
          <h2 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">A wrapper around Qdrant was not enough</h2>
          <p class="mt-5 text-lg text-muted">
            EAHR does not need two candidate lists that have already been truncated. It needs exact rank streams that
            remain open, resume from saved state, share a consistent snapshot, and fail closed. Repeated calls to a
            conventional Top-L API cannot provide those semantics.
          </p>
          <p class="mt-4 text-lg text-muted">
            I therefore forked Qdrant v1.18.2 in Rust and implemented EAHR inside its execution path. The result is
            StratuMind, a change to the retrieval engine rather than an external orchestration layer.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <article class="rounded-xl border border-gray-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900">
            <h3 class="text-lg font-semibold">PVS · Dense retrieval</h3>
            <p class="mt-2 text-muted">
              Per-vector scalar intervals narrow the candidate set. PVS evaluates only the vectors that require exact
              float32 scores and publishes the dense ranking in order.
            </p>
          </article>
          <article class="rounded-xl border border-gray-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900">
            <h3 class="text-lg font-semibold">PBM · Sparse retrieval</h3>
            <p class="mt-2 text-muted">
              PBM maintains block maxima over posting ranges in compressed inverted lists and incrementally publishes
              the exact sparse ranking.
            </p>
          </article>
          <article
            class="rounded-xl border border-gray-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900 sm:col-span-2"
          >
            <h3 class="text-lg font-semibold">A native execution protocol</h3>
            <p class="mt-2 text-muted">
              Rank streams merge at the Segment and Shard layers, with explicit handling for fixed snapshots,
              deterministic ties, exhaustion, cancellation, and failure.
            </p>
          </article>
        </div>
      </div>

      <div class="mt-10 flex justify-center">
        <a
          href="https://github.com/ln-one/StratuMind"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border-2 border-black bg-white px-6 py-2.5 text-sm font-semibold text-black shadow-sm transition hover:bg-gray-100"
        >
          <Icon name="tabler:brand-github" class="h-5 w-5 text-black" />
          GitHub
        </a>
      </div>

      <div class="mt-12 flex flex-wrap items-center justify-center gap-3 text-sm font-semibold">
        <span class="rounded-full border border-gray-300 bg-white px-4 py-2 dark:border-slate-600 dark:bg-slate-900"
          >Spectra query</span
        >
        <span aria-hidden="true" class="text-muted">→</span>
        <span class="rounded-full border border-gray-300 bg-white px-4 py-2 dark:border-slate-600 dark:bg-slate-900"
          >StratuMind / Qdrant fork</span
        >
        <span aria-hidden="true" class="text-muted">→</span>
        <span class="rounded-full border border-gray-300 bg-white px-4 py-2 dark:border-slate-600 dark:bg-slate-900"
          >PVS + PBM + adaptive WRRF</span
        >
        <span aria-hidden="true" class="text-muted">→</span>
        <span class="rounded-full border border-gray-300 bg-white px-4 py-2 dark:border-slate-600 dark:bg-slate-900"
          >Exact ordered Top-K</span
        >
      </div>

      <div
        class="mt-12 grid items-center gap-6 rounded-3xl border border-blue-200 bg-blue-50 p-7 dark:border-blue-900 dark:bg-blue-950/30 md:p-10 lg:grid-cols-[0.7fr_1.3fr]"
      >
        <div>
          <p class="text-sm font-bold uppercase tracking-widest text-secondary">Back to Spectra</p>
          <h3 class="mt-2 text-3xl font-bold tracking-tight">
            A problem found in a product, and research built back into it
          </h3>
        </div>
        <div>
          <p class="text-lg leading-8 text-muted">
            Spectra exposed a real engineering problem. EAHR turned it into a retrieval problem, and StratuMind made the
            proposed method executable inside the database. Spectra still receives an ordinary ordered Top-K response;
            continuation state, certification, and adaptive execution remain inside the retrieval system.
          </p>
          <p class="mt-4 text-lg leading-8 text-muted">
            The work now forms a complete loop: a product raised the question, the question became research, the
            research required a systems implementation, and that implementation returns to serve the product.
          </p>
          <a href="#spectra" class="mt-5 inline-flex text-sm font-semibold text-blue-600 hover:text-blue-700">
            Back to Spectra ↑
          </a>
        </div>
      </div>
    </div>
  </section>

  <Features3
    id="background"
    tagline="Background"
    title="Education and experience"
    columns={2}
    items={[
      {
        title: 'Southwest Jiaotong University · 2023 to 2027',
        description:
          'B.Eng. candidate in Software Engineering, School of Computing and Artificial Intelligence. CET-6: 514.',
        icon: 'tabler:school',
      },
      {
        title: 'Strong academic improvement',
        description:
          'Major rank improved from 135/189 in the first year to 8/88 in the second year and 6/90 in the fifth semester.',
        icon: 'tabler:trending-up',
      },
      {
        title: 'National competition finalist',
        description:
          'Led Team Crab Canon (Group A, No. 4) to the national final of the 17th China Undergraduate Service Outsourcing Innovation and Entrepreneurship Competition.',
        icon: 'tabler:trophy',
      },
      {
        title: 'Leadership and service',
        description:
          'Class monitor for Software Engineering Class 2023-02 for three consecutive years; probationary CPC member; recipient of the university-level Outstanding Communist Youth League Cadre, Merit Student, and Mingcheng awards.',
        icon: 'tabler:flag',
      },
    ]}
  />

  <CallToAction
    id="contact"
    title="I’d be glad to hear from you"
    subtitle="I am currently applying for graduate study. I developed EAHR independently and would value comments from researchers in the field. I would also be happy to introduce or demonstrate Spectra. Feel free to contact me by email."
    actions={[
      {
        variant: 'primary',
        text: 'Email me',
        href: 'mailto:chronis@my.swjtu.edu.cn',
        icon: 'tabler:mail',
      },
      {
        text: 'Try Spectra',
        href: 'https://spectra.forevergreendam.cn',
        target: '_blank',
        icon: 'tabler:external-link',
      },
      {
        text: 'Read EAHR on arXiv',
        href: 'https://arxiv.org/abs/2608.07152',
        target: '_blank',
        icon: 'tabler:external-link',
      },
    ]}
  />
</Layout>
