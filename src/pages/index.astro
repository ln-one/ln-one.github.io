---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Chunran Zhang — Research & Software Systems',
  description:
    'Chunran Zhang is a software engineering undergraduate at Southwest Jiaotong University working on exact retrieval, AI agents, and reliable software systems.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    id="home"
    tagline="Software Engineering · Southwest Jiaotong University"
    title="Chunran Zhang"
    actions={[
      { variant: 'primary', text: 'View research', href: '#research', icon: 'tabler:arrow-down' },
      { text: 'GitHub', href: 'https://github.com/ln-one', target: '_blank', icon: 'tabler:brand-github' },
    ]}
    image={{ src: '~/assets/images/chunran-zhang.jpg', alt: 'Portrait of Chunran Zhang' }}
  >
    <Fragment slot="subtitle">
      I study exact and adaptive information retrieval, and build AI-native systems that remain dependable beyond a
      prototype. Currently an undergraduate in Software Engineering, graduating in 2027.
    </Fragment>
  </Hero>

  <Features2
    id="about"
    tagline="About"
    title="Research-minded, engineering-grounded"
    subtitle="My work sits between information retrieval, AI agents, and software systems. I care about both the result contract and the system that has to uphold it."
    columns={3}
    items={[
      {
        title: 'Information Retrieval',
        description:
          'Exact Top-K processing, hybrid retrieval, rank fusion, vector and sparse search, and retrieval for RAG.',
        icon: 'tabler:search',
      },
      {
        title: 'AI-native Systems',
        description:
          'Agent workflows, evidence-grounded generation, durable execution, and evaluation for real applications.',
        icon: 'tabler:sparkles',
      },
      {
        title: 'Leadership',
        description:
          'Class monitor for three years, project lead, and probationary member of the Communist Party of China.',
        icon: 'tabler:users',
      },
    ]}
  />

  <Content
    id="research"
    tagline="Selected Research"
    title="Exact Adaptive Hybrid Retrieval Without Fixed Top-L Cutoffs"
    subtitle="A single-author preprint on making complete-list weighted RRF the result contract while adapting retrieval depth per request."
    items={[
      {
        title: 'Exact result contract',
        description:
          'Certifies the ordered Top-K of complete-list fusion rather than treating fixed retrieval depth as part of the result semantics.',
      },
      {
        title: 'Resumable rank streams',
        description:
          'Combines exact dense and sparse ranking prefixes with safe lower and upper bounds for position-wise certification.',
      },
      {
        title: 'Experimental evidence',
        description:
          'Matched the ordered Top-20 of complete fusion in all 150 reported query-snapshot combinations across five retrieval collections.',
      },
    ]}
    image={{ src: '~/assets/images/eahr-overview.png', alt: 'Overview of the EAHR retrieval and fusion process' }}
    callToAction={{
      text: 'Read the preprint',
      href: '/files/Chunran-Zhang-EAHR-preprint.pdf',
      target: '_blank',
      icon: 'tabler:file-text',
    }}
  />

  <Stats
    stats={[
      { amount: '1', title: 'Single author', icon: 'tabler:pencil' },
      { amount: '5', title: 'Collections', icon: 'tabler:database' },
      { amount: '150/150', title: 'Exact Top-20 matches', icon: 'tabler:circle-check' },
      { amount: '2027', title: 'Expected graduation', icon: 'tabler:school' },
    ]}
  />

  <Content
    id="projects"
    isReversed
    tagline="Selected Project"
    title="Spectra"
    subtitle="A multimodal knowledge creation workspace for turning source material into grounded educational content and interactive artifacts."
    items={[
      {
        title: 'System scope',
        description:
          'Connects ingestion, hybrid retrieval, evidence tracing, agent planning, content generation, editing, export, and revision workflows.',
      },
      {
        title: 'My role',
        description:
          'Five-person team lead. Except for part of the visual frontend design, I built the product architecture and core system end to end.',
      },
      {
        title: 'Recognition',
        description:
          'Finalist in the 17th Chinese Collegiate Computing Competition — Service Outsourcing Innovation and Entrepreneurship Competition.',
      },
    ]}
    image={{ src: '~/assets/images/spectra-visual.png', alt: 'Spectra visual identity' }}
    callToAction={{
      text: 'Open Spectra',
      href: 'https://spectra.forevergreendam.cn',
      target: '_blank',
      icon: 'tabler:external-link',
    }}
  />

  <Features3
    id="experience"
    tagline="Background"
    title="Education & recognition"
    columns={2}
    items={[
      {
        title: 'Southwest Jiaotong University · 2023–2027',
        description:
          'B.Eng. candidate in Software Engineering, School of Computing and Artificial Intelligence. CET-6: 514.',
        icon: 'tabler:school',
      },
      {
        title: 'Strong upward academic trajectory',
        description:
          'Major ranking improved from 135/189 in the first year to 8/88 in the second year and 6/90 in the fifth semester.',
        icon: 'tabler:trending-up',
      },
      {
        title: 'National competition finalist',
        description:
          'Led Spectra into the national final of the 17th Service Outsourcing Innovation and Entrepreneurship Competition.',
        icon: 'tabler:trophy',
      },
      {
        title: 'Service & leadership',
        description:
          'Three-year class monitor; Outstanding Communist Youth League Cadre; led the class to university-level recognition.',
        icon: 'tabler:flag',
      },
    ]}
  />

  <CallToAction
    id="contact"
    title="Let’s talk about retrieval and AI systems"
    subtitle="I am currently preparing for graduate study and open to research conversations and collaboration."
    actions={[
      {
        variant: 'primary',
        text: 'Email me',
        href: 'mailto:chronis@my.swjtu.edu.cn',
        icon: 'tabler:mail',
      },
      {
        text: 'Download CV',
        href: '/files/Chunran-Zhang-CV.pdf',
        target: '_blank',
        icon: 'tabler:download',
      },
    ]}
  />
</Layout>
